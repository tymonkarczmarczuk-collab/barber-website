# ------------------------------------------------------------------
# SARVEON — environment
# Copy to .env.local and fill in what you actually use.
# The site runs with none of these set; features stay honestly off.
# ------------------------------------------------------------------

# Canonical origin. Used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://sarveon.com

# Addresses shown on the site (optional — sensible defaults are built in).
NEXT_PUBLIC_CONTACT_EMAIL=hello@sarveon.com
NEXT_PUBLIC_PRESS_EMAIL=press@sarveon.com
NEXT_PUBLIC_SERVICE_EMAIL=service@sarveon.com

# ------------------------------------------------------------------
# ENQUIRY FORM  →  lib/services/contactService.ts
# One of: resend | formspree | webhook | log
# Unset in development behaves as "log" (prints to the server console).
# Unset in production makes the form report that it is not connected —
# it never shows a success screen for a message that went nowhere.
# ------------------------------------------------------------------
CONTACT_PROVIDER=

# --- resend -------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- formspree ----------------------------------------------------
FORMSPREE_ENDPOINT=

# --- webhook (Supabase Edge Function, Zapier, your own endpoint) ---
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# ------------------------------------------------------------------
# CHECKOUT  →  lib/commerce/checkout.ts + app/api/checkout/route.ts
# One of: none | stripe | shopify | custom
# Leave as "none" (or unset) while Passage 01 is enquiry-only, and set
# product.availability in lib/config/product.ts to "sale" when a real
# checkout is wired up.
# ------------------------------------------------------------------
NEXT_PUBLIC_CHECKOUT_PROVIDER=none

# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
